# Copy this file to ~/.zshrc. It is intentionally an example, not a managed file.

typeset -U path PATH
export PATH="$HOME/.local/bin:${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export PATH="$HOME/.config/emacs/bin:$PATH"
export EDITOR="nvim"
export VISUAL="nvim"

# Keep credentials local and outside the dotfiles repository.
[[ -r "$HOME/.config/zsh/secrets.zsh" ]] && source "$HOME/.config/zsh/secrets.zsh"

# Oh My Zsh loads NVM on the first nvm/node/npm/npx/etc. command.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
zstyle ':omz:plugins:nvm' lazy yes

ZSH_THEME=""
plugins=(git nvm)
source "$ZSH/oh-my-zsh.sh"

setopt AUTO_CD AUTO_MENU AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_MINUS

zstyle ':completion:*:*:*:*:*' menu select
zstyle ':completion:*' matcher-list \
  'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' \
  'r:|=*' \
  'l:|=* r:|=*'

bindkey -e

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^G' edit-command-line

alias ..='cd ..'
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'
alias -- -='cd -'
alias md='mkdir -p'
alias rd='rmdir'
alias sl='ls'
alias l='ls -lah'
alias ll='ls -lh'
alias la='ls -lAh'
alias lsa='ls -lah'

alias g="lazygit"
alias t="tmux"
alias vim="nvim"
alias vi="nvim"
alias mkvenv="uv venv .venv && source .venv/bin/activate && uv pip install -r requirements.txt"
alias venv="source .venv/bin/activate"
alias cls="clear"
alias h="herdr"
alias mp="npx skills@latest add mattpocock/skills"
alias ek="npx skills@latest add emilkowalski/skills"

# Initialize after Oh My Zsh and bindkey -e so these bindings win.
if command -v clio >/dev/null 2>&1 && [[ -r "${XDG_DATA_HOME:-$HOME/.local/share}/clio/clio.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/clio/clio.zsh"
  bindkey '^[[A' clio-history
  bindkey '^[OA' clio-history
fi

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

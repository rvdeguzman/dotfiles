# Copy this file to ~/.zshrc. It is intentionally an example, not a managed file.

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export PATH="$HOME/.config/emacs/bin:$PATH"
ZSH_THEME=""
plugins=(git)
source "$ZSH/oh-my-zsh.sh"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

alias g="lazygit"
alias t="tmux"
alias vim="nvim"
alias vi="nvim"
alias mkvenv="uv venv .venv && source .venv/bin/activate && uv pip install -r requirements.txt"
alias venv="source .venv/bin/activate"
alias cls="clear"
alias h="herdr"
alias mp="npx skills@latest add mattpocock/skills"
alias ek="npx skills@latest add emilkowalski/skills"

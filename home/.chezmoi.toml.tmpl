{{/* Generates ~/.config/chezmoi/chezmoi.toml on `chezmoi init`. */ -}}
{{- $hyprland := false -}}
{{- $minibook := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $hyprland = promptBoolOnce . "hyprland" "Manage Hyprland configs (hypr, mako, waybar, wofi)" (not (empty (env "HYPRLAND_INSTANCE_SIGNATURE"))) -}}
{{-   if $hyprland -}}
{{-     $minibook = promptBoolOnce . "minibook" "Use the MiniBook X Hyprland variant (rotated panel + touch)" (eq (output "sh" "-c" "cat /sys/class/dmi/id/product_name 2>/dev/null | tr -d '\n'") "MiniBook X") -}}
{{-   end -}}
{{- end -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    hyprland = {{ $hyprland }}
    minibook = {{ $minibook }}

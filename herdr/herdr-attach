#!/usr/bin/env bash
# tmux-like default: `herdr-attach` opens/focuses a workspace at $PWD, then attaches.
# - no server running yet -> `herdr` bootstrap already creates a workspace at cwd, just exec it.
# - server running        -> focus an existing workspace whose pane cwd matches $PWD,
#                             or create+focus a new one, then attach.
set -euo pipefail

cwd=$(pwd -P)

if ! herdr status server --json 2>/dev/null | jq -e '.running' >/dev/null 2>&1; then
    exec herdr "$@"
fi

workspace_id=$(herdr pane list 2>/dev/null \
    | jq -r --arg cwd "$cwd" '.result.panes[] | select(.cwd == $cwd) | .workspace_id' \
    | head -n1)

if [[ -n "$workspace_id" ]]; then
    herdr workspace focus "$workspace_id" >/dev/null
else
    herdr workspace create --cwd "$cwd" --focus >/dev/null
fi

exec herdr "$@"

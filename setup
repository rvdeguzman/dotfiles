#!/usr/bin/env bash
# macOS bootstrap: install chezmoi if missing and initialize this repo. No apply.
# Extra arguments are passed to chezmoi init.
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This repository supports macOS only.' >&2; exit 1; }
command -v brew >/dev/null 2>&1 || { echo 'Install Homebrew first: https://brew.sh/' >&2; exit 1; }
REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)

if ! command -v chezmoi >/dev/null 2>&1; then
  brew install chezmoi
fi

chezmoi init --source "$REPO_DIR" "$@"
echo 'Initialized without applying. Follow docs/machine-setup.md to bootstrap dot, review, and apply.'

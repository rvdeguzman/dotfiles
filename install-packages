#!/usr/bin/env bash
# Install the macOS Brewfile explicitly. Never runs during setup or apply.
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This repository supports macOS only.' >&2; exit 1; }
[[ $# -eq 0 ]] || { echo 'usage: ./install-packages (no profiles; uses Brewfile)' >&2; exit 2; }
command -v brew >/dev/null 2>&1 || { echo 'Install Homebrew first: https://brew.sh/' >&2; exit 1; }
cd "$(dirname "$0")"
brew bundle --no-upgrade --file=Brewfile

#!/usr/bin/env bash
# Install packages. Never runs automatically.
#   macOS: ./install-packages                 (single Brewfile, brew bundle --no-upgrade)
#   Arch:  ./install-packages base minibook    (Omarchy extras via paru/yay -S --needed)
set -euo pipefail
cd "$(dirname "$0")"

case "$(uname)" in
Darwin)
  brew bundle --no-upgrade --file="packages/macos/Brewfile"
  ;;
*)
  if [ $# -eq 0 ]; then
    echo "usage: ./install-packages <profile>..." >&2
    echo "profiles:" >&2
    ls packages/arch >&2
    exit 1
  fi
  mgr=$(command -v paru || command -v yay) || { echo "Error: need paru or yay" >&2; exit 1; }
  packages=()
  for p in "$@"; do
    profile="packages/arch/$p.txt"
    [[ -f "$profile" ]] || { echo "Error: unknown profile: $p" >&2; exit 1; }
    while IFS= read -r package; do
      packages+=("$package")
    done < <(grep -vE '^[[:space:]]*(#|$)' "$profile")
  done
  "$mgr" -S --needed "${packages[@]}"
  ;;
esac

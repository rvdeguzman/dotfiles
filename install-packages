#!/usr/bin/env bash
# Install one or more package profiles. Never runs automatically.
#   ./install-packages core terminal
# macOS: packages/macos/<profile>.Brewfile via `brew bundle --no-upgrade`
# Arch:  packages/arch/<profile>.txt via paru/yay -S --needed
set -euo pipefail
cd "$(dirname "$0")"

if [ $# -eq 0 ]; then
  echo "usage: ./install-packages <profile>..." >&2
  echo "profiles:" >&2
  ls packages/macos packages/arch >&2
  exit 1
fi

case "$(uname)" in
Darwin)
  for p in "$@"; do
    brew bundle --no-upgrade --file="packages/macos/$p.Brewfile"
  done
  ;;
*)
  mgr=$(command -v paru || command -v yay) || { echo "Error: need paru or yay" >&2; exit 1; }
  for p in "$@"; do
    grep -hvE '^[[:space:]]*(#|$)' "packages/arch/$p.txt"
  done | xargs "$mgr" -S --needed
  ;;
esac

#!/usr/bin/env bash
# Install macOS tools outside Homebrew. Never runs automatically.
#   ./install-extras
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This repository supports macOS only.' >&2; exit 1; }
[[ $# -eq 0 ]] || { echo 'usage: ./install-extras' >&2; exit 2; }

command -v pi >/dev/null 2>&1 || npm install -g @earendil-works/pi-coding-agent
command -v herdr >/dev/null 2>&1 || curl -fsSL https://herdr.dev/install.sh | sh
[ -d "${ZSH:-$HOME/.oh-my-zsh}" ] || RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
